{
  "providers": [
    {
      "id": "anthropic",
      "vendor": "Anthropic",
      "tool": "Claude Code",
      "command": "claude",
      "package": "@anthropic-ai/claude-code",
      "versionArgs": ["--version"],
      "usage": "claude",
      "history": "claude",
      "reporting": "claude",
      "homeVar": "CLAUDE_CONFIG_DIR",
      "accountEnv": { "CLAUDE_SECURESTORAGE_CONFIG_DIR": "{dir}" },
      "hooks": { "path": "settings.json", "example": "claude-code-settings.json" },
      "modelPattern": "claude-(?:opus|sonnet|haiku|fable|\\d)[a-z0-9.-]*|\\b(?:opus|sonnet|haiku|fable)\\s?\\d+(?:\\.\\d+)?",
      "args": [],
      "resumeArgs": ["--resume", "{id}"],
      "color": "#D97757",
      "monogram": "A",
      "install": "curl -fsSL https://claude.ai/install.sh | bash",
      "npmNote": "npm installs the same native build as Anthropic's installer.",
      "channels": {
        "native": { "paths": ["~/.local/bin/claude", "~/.local/share/claude"], "update": ["update"], "remove": ["~/.local/bin/claude", "~/.local/share/claude"] },
        "brew": { "names": ["claude-code", "claude-code@latest"] },
        "winget": { "id": "Anthropic.ClaudeCode" },
        "legacy": { "paths": ["~/.claude/local"], "guidance": "This copy comes from an older Claude Code installer. Remove ~/.claude/local and reinstall with the current installer.", "remove": ["~/.claude/local"] }
      },
      "docs": "https://code.claude.com/docs/en/setup",
      "usageUrl": "https://claude.ai/settings/usage",
      "billingUrl": "https://claude.ai/settings/billing",
      "cloudUrl": "https://claude.ai/code",
      "win32": {
        "install": "irm https://claude.ai/install.ps1 | iex",
        "channels": {
          "native": { "paths": ["~/.local/bin/claude", "~/.local/share/claude"], "update": ["update"], "remove": ["~/.local/bin/claude.exe", "~/.local/share/claude"] },
          "winget": { "id": "Anthropic.ClaudeCode" },
          "legacy": { "paths": ["~/.claude/local"], "guidance": "This copy comes from an older Claude Code installer. Remove ~/.claude/local and reinstall with the current installer.", "remove": ["~/.claude/local"] }
        }
      }
    },
    {
      "id": "openai",
      "vendor": "OpenAI",
      "tool": "Codex CLI",
      "command": "codex",
      "package": "@openai/codex",
      "versionArgs": ["--version"],
      "usage": "codex",
      "history": "codex",
      "reporting": "codex",
      "homeVar": "CODEX_HOME",
      "hooks": { "path": "hooks.json", "example": "codex-hooks.json" },
      "modelPattern": "\\bgpt-\\d[a-z0-9.-]*",
      "args": [],
      "resumeArgs": ["resume", "{id}"],
      "color": "#10A37F",
      "monogram": "O",
      "install": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
      "npmNote": "npm installs the native Codex binary.",
      "channels": {
        "native": { "paths": ["~/.local/bin/codex", "~/.codex/packages/standalone"], "update": ["update"], "remove": ["~/.local/bin/codex", "~/.local/bin/codex-code-mode-host", "~/.codex/packages/standalone"] },
        "brew": { "names": ["codex"] },
        "winget": { "id": "OpenAI.Codex" }
      },
      "docs": "https://github.com/openai/codex",
      "usageUrl": "https://chatgpt.com/codex/settings/usage",
      "billingUrl": "https://chatgpt.com/#settings/Billing",
      "cloudUrl": "https://chatgpt.com/codex",
      "win32": {
        "install": "powershell -ExecutionPolicy ByPass -c \"irm https://chatgpt.com/codex/install.ps1 | iex\"",
        "channels": {
          "native": { "paths": ["~/AppData/Local/Programs/OpenAI/Codex/bin", "~/.codex/packages/standalone"], "update": ["update"], "remove": ["~/AppData/Local/Programs/OpenAI/Codex/bin", "~/.codex/packages/standalone"] },
          "winget": { "id": "OpenAI.Codex" }
        }
      }
    },
    {
      "id": "google",
      "vendor": "Google",
      "tool": "Antigravity CLI",
      "command": "agy",
      "versionArgs": ["--version"],
      "history": "antigravity",
      "reporting": "antigravity",
      "modelPattern": "\\bgemini-\\d[a-z0-9.-]*",
      "args": [],
      "resumeArgs": ["--conversation", "{id}"],
      "color": "#4285F4",
      "monogram": "G",
      "install": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "channels": {
        "native": { "paths": ["~/.local/bin/agy"], "update": ["update"], "remove": ["~/.local/bin/agy"] },
        "brew": { "names": ["antigravity-cli"], "autoUpdates": true }
      },
      "docs": "https://antigravity.google/docs/cli/install",
      "billingUrl": "https://one.google.com/settings",
      "cloudUrl": "https://gemini.google.com/",
      "win32": {
        "install": "irm https://antigravity.google/cli/install.ps1 | iex",
        "channels": {
          "native": { "paths": ["~/AppData/Local/agy/bin"], "update": ["update"], "remove": ["~/AppData/Local/agy"] }
        }
      }
    },
    {
      "id": "xai",
      "vendor": "xAI",
      "tool": "Grok Build",
      "command": "grok",
      "package": "@xai-official/grok",
      "versionArgs": ["--version"],
      "history": "grok",
      "reporting": "grok",
      "homeVar": "GROK_HOME",
      "hooks": { "path": "hooks/agent-guild.json", "example": "grok-hooks.json" },
      "modelPattern": "\\bgrok-(?:build|\\d)[a-z0-9.-]*",
      "args": [],
      "resumeArgs": ["--resume", "{id}"],
      "color": "#6B7280",
      "monogram": "X",
      "install": "curl -fsSL https://x.ai/cli/install.sh | bash",
      "npmNote": "npm installs the native grok binary into ~/.grok/bin.",
      "channels": {
        "native": { "paths": ["~/.grok/bin", "~/.grok/downloads"], "update": ["update"], "remove": ["~/.grok/bin", "~/.grok/downloads", "~/.grok/completions"], "links": ["~/.local/bin/grok", "~/.local/bin/agent", "/usr/local/bin/grok", "/usr/local/bin/agent"], "sharedWithNpm": true },
        "brew": { "names": ["grok-build"] }
      },
      "docs": "https://docs.x.ai/build/overview",
      "usageUrl": "https://grok.com/?_s=usage",
      "billingUrl": "https://grok.com/?_s=billing",
      "cloudUrl": "https://grok.com/",
      "win32": {
        "install": "irm https://x.ai/cli/install.ps1 | iex"
      }
    },
    {
      "id": "docker",
      "vendor": "Docker",
      "tool": "Docker Agent",
      "command": "docker",
      "versionArgs": ["agent", "version"],
      "history": "docker",
      "reporting": "docker",
      "hooks": { "path": "hooks.d/agent-guild.yaml", "example": "docker-agent-hooks.yaml" },
      "args": ["agent", "run"],
      "resumeArgs": ["--session", "{id}"],
      "color": "#2496ED",
      "monogram": "D",
      "install": "mkdir -p ~/.docker/cli-plugins && curl -fsSL \"https://github.com/docker/docker-agent/releases/latest/download/docker-agent-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')\" -o ~/.docker/cli-plugins/docker-agent.tmp && chmod +x ~/.docker/cli-plugins/docker-agent.tmp && mv -f ~/.docker/cli-plugins/docker-agent.tmp ~/.docker/cli-plugins/docker-agent",
      "docs": "https://docker.github.io/docker-agent/getting-started/installation/",
      "win32": {
        "install": "$d = \"$HOME\\.docker\\cli-plugins\"; New-Item -ItemType Directory -Force $d | Out-Null; $a = if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' } else { 'amd64' }; irm \"https://github.com/docker/docker-agent/releases/latest/download/docker-agent-windows-$a.exe\" -OutFile \"$d\\docker-agent.exe\""
      }
    },
    {
      "id": "shell",
      "vendor": "Local",
      "tool": "Shell",
      "command": "@shell",
      "multiplexers": [
        { "id": "tmux", "docs": "https://github.com/tmux/tmux/wiki/Installing", "channels": { "brew": { "names": ["tmux"] } } },
        { "id": "herdr", "docs": "https://herdr.dev/docs/install/", "channels": { "brew": { "names": ["herdr"] } } }
      ],
      "args": [],
      "color": "#8B5CF6",
      "monogram": ">",
      "install": "",
      "docs": ""
    }
  ]
}
