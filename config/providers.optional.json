{
  "providers": [
    {
      "id": "terminal-ai-chat",
      "vendor": "Odd Essentials",
      "tool": "Terminal AI Chat",
      "command": "terminal-ai-chat",
      "versionArgs": ["--version"],
      "color": "#C8983A",
      "monogram": "T",
      "releases": "https://github.com/oddessentials/terminal-ai-chat-releases/releases/latest",
      "install": "curl -fsSL https://github.com/oddessentials/terminal-ai-chat-releases/releases/latest/download/install.sh | sh",
      "docs": "https://github.com/oddessentials/terminal-ai-chat-releases",
      "channels": {
        "native": { "paths": ["~/.local/bin/terminal-ai-chat"], "remove": ["~/.local/bin/terminal-ai-chat"], "reinstall": true, "versionEnv": "TAC_VERSION" },
        "brew": { "names": ["terminal-ai-chat"] }
      },
      "win32": {
        "install": "irm https://github.com/oddessentials/terminal-ai-chat-releases/releases/latest/download/install.ps1 | iex",
        "channels": {
          "native": { "paths": ["~/AppData/Local/Programs/terminal-ai-chat"], "remove": ["~/AppData/Local/Programs/terminal-ai-chat"], "reinstall": true, "versionEnv": "TAC_VERSION" },
          "winget": { "id": "OddEssentials.TerminalAIChat" }
        }
      }
    },
    {
      "id": "hermes",
      "vendor": "Nous Research",
      "tool": "Hermes Agent",
      "command": "hermes",
      "versionArgs": ["--version"],
      "reporting": "hermes",
      "mcp": "hermes",
      "homeVar": "HERMES_HOME",
      "profiles": "hermes",
      "resumeArgs": ["--resume", "{id}"],
      "color": "#8B5CF6",
      "monogram": "H",
      "install": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash",
      "docs": "https://hermes-agent.nousresearch.com/docs",
      "channels": {
        "native": { "paths": ["~/.local/bin/hermes", "~/.hermes/hermes-agent"], "update": ["update"] }
      },
      "win32": {
        "install": "iex (irm https://hermes-agent.nousresearch.com/install.ps1)"
      }
    }
  ]
}
