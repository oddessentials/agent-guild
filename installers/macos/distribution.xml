<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Agent Guild</title>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <options customize="never" require-scripts="false" hostArchitectures="@ARCH@"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="13.5"/>
    </allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" title="Agent Guild">
    <pkg-ref id="ai.oddessentials.agent-guild"/>
  </choice>
  <pkg-ref id="ai.oddessentials.agent-guild" version="@VERSION@" onConclusion="none">agent-guild.pkg</pkg-ref>
</installer-gui-script>
