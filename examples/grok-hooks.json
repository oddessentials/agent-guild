{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --hook"
          }
        ]
      }
    ],
    "StopCancelled": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
