{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --claude-hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --claude-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --claude-hook"
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-guild-report --claude-hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "agent-guild-report --claude-statusline"
  }
}
