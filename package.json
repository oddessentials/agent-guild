{
  "name": "@oddessentials/agent-guild",
  "version": "0.0.0-development",
  "description": "Launch and watch AI coding-assistant terminal sessions from one local web page. A bundled session manager owns the terminals so the page can close and reconnect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddessentials/agent-guild.git"
  },
  "homepage": "https://github.com/oddessentials/agent-guild#readme",
  "bugs": {
    "url": "https://github.com/oddessentials/agent-guild/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-guild": "bin/agent-guild.mjs",
    "agent-guild-report": "bin/agent-guild-report.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "config/",
    "examples/"
  ],
  "scripts": {
    "start": "node bin/agent-guild.mjs open",
    "manager": "node bin/agent-guild.mjs start",
    "stop": "node bin/agent-guild.mjs stop",
    "status": "node bin/agent-guild.mjs status",
    "test": "node --test --test-concurrency=1",
    "build:yard": "node scripts/build-yard.mjs",
    "optimize:yard": "node scripts/optimize-yard.mjs",
    "test:yard": "node --test --test-concurrency=1 tests/yard.test.mjs tests/yard-browser.test.mjs",
    "preview:yard": "node docs/yard/preview.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.2.0-beta.15",
    "ws": "^8.22.0"
  },
  "bundleDependencies": [
    "@xterm/addon-fit",
    "@xterm/addon-serialize",
    "@xterm/addon-web-links",
    "@xterm/headless",
    "@xterm/xterm",
    "node-pty",
    "ws"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.28.2",
    "three": "0.186.1"
  }
}
